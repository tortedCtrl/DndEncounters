<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DndEncounters.MainWindow"
        Title="D&amp;D Encounters"
        Icon="/icon.ico"
        Width="1280"
        Height="900"
        MinWidth="900"
        MinHeight="650"
        Background="#10131B"
        FontFamily="Inter">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#10131B" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#151923" />
        <SolidColorBrush x:Key="CardBrush" Color="#191E29" />
        <SolidColorBrush x:Key="InputBrush" Color="#171B25" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#202633" />
        <SolidColorBrush x:Key="TextBrush" Color="#E9E7E2" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9299A6" />
        <SolidColorBrush x:Key="InputTextBrush" Color="#F2F0EA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#303746" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C69A53" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#17130D" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C93636" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.home">
            <Setter Property="Background" Value="#2E7D6B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.home:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3A9983" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.home:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#256858" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#C69A53" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Border.dynamic-card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Expander.dynamic-card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
    </Window.Styles>
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,12">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#302719">
                        <TextBlock Text="✦" Foreground="#D5A95F" FontSize="21"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock Text="D&amp;D ENCOUNTERS" FontSize="11" FontWeight="Bold"
                                   Foreground="#C69A53" />
                        <TextBlock Text="Бестиарий и игровые сцены" FontSize="13" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="NavigationPanel" Grid.Column="1" Orientation="Horizontal"
                            Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button x:Name="ThemeButton" Grid.Column="2" Classes="quiet"
                        Content="Светлая тема" VerticalAlignment="Center" />
                <StackPanel x:Name="MenuPanel" Grid.Row="1" Grid.ColumnSpan="3"
                            Orientation="Horizontal" Spacing="8" Margin="46,8,0,0" />
            </Grid>
        </Border>
        <ContentControl x:Name="ContentHost" Grid.Row="1" />
        <StackPanel x:Name="ToastPanel" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,24" Spacing="8" />
    </Grid>
</Window>
